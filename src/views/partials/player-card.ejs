<% if (player.isPlaceholder) { %>
  <article class="fifa-card fifa-card--empty" role="status" aria-label="Espacio disponible: <%= player.lineupRole %>">
    <div class="fifa-card__shape" aria-hidden="true"></div>
    <div class="fifa-card__info">
      <span class="fifa-card__num">0</span>
      <i aria-hidden="true"></i>
      <span class="fifa-card__position"><%= player.lineupRole || 'JUG' %></span>
    </div>
    <span class="fifa-card__photo-placeholder" aria-hidden="true"></span>
    <div class="fifa-card__name">VACANTE</div>
    <div class="fifa-card__stats" aria-hidden="true">
      <span><b>0</b><span>GOL</span></span>
      <span><b>0</b><span>AST</span></span>
      <span><b>0</b><span>ATA</span></span>
    </div>
  </article>
<% } else { %>
  <article class="fifa-card <%= compact ? 'fifa-card--compact' : '' %> <%= player.goles > 0 ? 'fifa-card--scorer' : '' %> <%= player.goles > 0 && player.goles === topTeamGoals ? 'fifa-card--top-scorer' : '' %>">
    <div class="fifa-card__shape" aria-hidden="true"></div>
    <div class="fifa-card__info">
      <span class="fifa-card__num"><%= player.numero_camiseta || '0' %></span>
      <i aria-hidden="true"></i>
      <span class="fifa-card__position"><%= player.posicion || player.lineupRole || 'DEL' %></span>
    </div>
    <% if (player.fotoUrl) { %>
      <img class="fifa-card__photo" src="<%= player.fotoUrl %>" alt="Foto de <%= player.nombre %>" loading="lazy">
    <% } else { %>
      <span class="fifa-card__photo-placeholder" aria-hidden="true"></span>
    <% } %>
    <div class="fifa-card__name"><%= player.nombre ? player.nombre.split(' ').pop() : 'JUGADOR' %></div>
    <div class="fifa-card__stats" aria-label="Estadísticas de <%= player.nombre %>">
      <span><b><%= player.goles || 0 %></b><span>GOL</span></span>
      <span><b><%= player.asistencias || 0 %></b><span>AST</span></span>
      <span><b><%= player.atajadas || 0 %></b><span>ATA</span></span>
    </div>
  </article>
<% } %>
