<dialog class="privacy-policy-modal" id="privacy-policy-modal" aria-labelledby="privacy-policy-title">
  <article class="privacy-policy-modal__surface">
    <header class="privacy-policy-modal__heading">
      <div>
        <p class="eyebrow section-eyebrow">Torneo Interclases LJV</p>
        <h2 id="privacy-policy-title">Política de Tratamiento y Protección de Datos Personales (Provisional)</h2>
        <p>Institución Educativa Lucrecio Jaramillo Vélez</p>
      </div>
      <form method="dialog">
        <button class="privacy-policy-modal__close" type="submit" aria-label="Cerrar política de tratamiento de datos">&times;</button>
      </form>
    </header>
    <div class="privacy-policy-modal__content">
      <%- include('privacy-policy-content') %>
    </div>
  </article>
</dialog>
