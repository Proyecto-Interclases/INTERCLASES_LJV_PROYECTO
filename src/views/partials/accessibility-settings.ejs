<div class="floating-tools" aria-label="Herramientas de accesibilidad y configuración">
  <div class="floating-tool floating-tool--left">
    <button class="floating-tool__button floating-btn-accessibility floating-tool__button--accessibility" id="accessibility-toggle" type="button" aria-label="Abrir panel de accesibilidad" aria-expanded="false" aria-controls="accessibility-panel" data-tooltip="Accesibilidad">
      <span class="floating-tool__icon-wrapper" aria-hidden="true">
        <svg class="floating-tool__icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" focusable="false" aria-hidden="true">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
          <circle cx="12" cy="5.4" r="2.1"></circle>
          <path d="M19 8.8H5a1.1 1.1 0 0 0 0 2.2h3.8v2.4l-2.4 5.3a1.1 1.1 0 0 0 2 .9l2.4-5.2h2.4l2.4 5.2a1.1 1.1 0 0 0 2-.9l-2.4-5.3V11H19a1.1 1.1 0 0 0 0-2.2z"></path>
        </svg>
      </span>
    </button>

    <section class="floating-panel accessibility-panel" id="accessibility-panel" aria-labelledby="accessibility-title" hidden>
      <div class="floating-panel__header">
        <div class="floating-panel__header-title">
          <svg class="floating-panel__title-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
            <circle cx="12" cy="5.4" r="2.1"></circle>
            <path d="M19 8.8H5a1.1 1.1 0 0 0 0 2.2h3.8v2.4l-2.4 5.3a1.1 1.1 0 0 0 2 .9l2.4-5.2h2.4l2.4 5.2a1.1 1.1 0 0 0 2-.9l-2.4-5.3V11H19a1.1 1.1 0 0 0 0-2.2z"></path>
          </svg>
          <h2 id="accessibility-title">Accesibilidad</h2>
        </div>
        <span class="floating-panel__badge">Ajustes</span>
      </div>

      <!-- Tamaño del texto -->
      <div class="accessibility-group">
        <div class="accessibility-group__heading">
          <span class="accessibility-group__label">Tamaño del texto</span>
          <span class="accessibility-group__val" id="font-size-val" aria-live="polite">100%</span>
        </div>
        <div class="accessibility-font-controls" aria-label="Controles de tamaño de letra">
          <button type="button" data-font-action="decrease" title="Reducir tamaño del texto" aria-label="Disminuir tamaño de letra">
            <span aria-hidden="true">A-</span>
            <small>Reducir</small>
          </button>
          <button type="button" data-font-action="reset-font" title="Restablecer tamaño normal" aria-label="Restablecer tamaño normal de letra">
            <span aria-hidden="true" class="accessibility-font-controls__default">100%</span>
            <small>Normal</small>
          </button>
          <button type="button" data-font-action="increase" title="Aumentar tamaño del texto" aria-label="Aumentar tamaño de letra">
            <span aria-hidden="true">A+</span>
            <small>Aumentar</small>
          </button>
        </div>
      </div>

      <!-- Opciones / Interruptores -->
      <div class="accessibility-switches">
        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Alto contraste</span>
            <span class="setting-switch__description">Fondo negro y elementos resaltados</span>
          </span>
          <input type="checkbox" data-accessibility="contrast" aria-label="Activar alto contraste">
          <span class="switch-track" aria-hidden="true"></span>
        </label>

        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Resaltar enlaces</span>
            <span class="setting-switch__description">Subraya y destaca botones y links</span>
          </span>
          <input type="checkbox" data-accessibility="highlight-links" aria-label="Activar resaltado de enlaces">
          <span class="switch-track" aria-hidden="true"></span>
        </label>

        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Lectura clara</span>
            <span class="setting-switch__description">Tipografía limpia y caracteres nítidos</span>
          </span>
          <input type="checkbox" data-accessibility="reading" aria-label="Activar lectura clara">
          <span class="switch-track" aria-hidden="true"></span>
        </label>

        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Espaciado de texto</span>
            <span class="setting-switch__description">Mayor interlineado y separación</span>
          </span>
          <input type="checkbox" data-accessibility="spacing" aria-label="Activar mayor espaciado de texto">
          <span class="switch-track" aria-hidden="true"></span>
        </label>

        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Reducir animaciones</span>
            <span class="setting-switch__description">Detiene transiciones y efectos visuales</span>
          </span>
          <input type="checkbox" data-accessibility="motion" aria-label="Reducir animaciones y movimiento">
          <span class="switch-track" aria-hidden="true"></span>
        </label>

        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Cursor grande</span>
            <span class="setting-switch__description">Puntero amplio de alta visibilidad</span>
          </span>
          <input type="checkbox" data-accessibility="cursor" aria-label="Activar cursor grande">
          <span class="switch-track" aria-hidden="true"></span>
        </label>

        <label class="setting-switch">
          <span class="setting-switch__info">
            <span class="setting-switch__title">Guía de lectura</span>
            <span class="setting-switch__description">Línea de enfoque que sigue el cursor</span>
          </span>
          <input type="checkbox" data-accessibility="ruler" aria-label="Activar guía de lectura">
          <span class="switch-track" aria-hidden="true"></span>
        </label>
      </div>

      <button class="floating-panel__reset" type="button" data-accessibility="reset" aria-label="Restablecer todos los ajustes de accesibilidad">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
        <span>Restablecer todo</span>
      </button>
    </section>
  </div>

  <div class="floating-tool floating-tool--right">
    <button class="floating-tool__button floating-btn-theme floating-tool__button--settings" id="settings-toggle" type="button" aria-label="Abrir configuración de apariencia" aria-expanded="false" aria-controls="settings-panel" data-tooltip="Cambiar tema">
      <span class="floating-tool__icon-wrapper" aria-hidden="true">
        <svg class="floating-tool__icon theme-icon theme-icon--light" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
        </svg>
        <svg class="floating-tool__icon theme-icon theme-icon--dark" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.7 8.7 0 1 0 20.5 14.2Z"></path>
        </svg>
      </span>
    </button>
    <section class="floating-panel settings-panel" id="settings-panel" aria-labelledby="settings-title" hidden>
      <div class="floating-panel__header">
        <div class="floating-panel__header-title">
          <svg class="floating-panel__title-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
          </svg>
          <h2 id="settings-title">Configuración</h2>
        </div>
      </div>
      <label class="setting-switch">
        <span class="setting-switch__info">
          <span class="setting-switch__title">Tema oscuro</span>
          <span class="setting-switch__description">Cambiar a colores oscuros</span>
        </span>
        <input type="checkbox" data-theme-toggle aria-label="Alternar tema oscuro">
        <span class="switch-track" aria-hidden="true"></span>
      </label>
    </section>
  </div>
</div>
<!-- Regla / Guía de lectura para seguimiento visual -->
<div id="accessibility-reading-ruler" class="reading-ruler" hidden aria-hidden="true"></div>
<script src="/js/accessibility-settings.js" defer></script>
