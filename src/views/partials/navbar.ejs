<header class="site-header">
  <nav class="site-nav" aria-label="Navegación principal">
    <a class="site-brand" href="/" aria-label="Ir al inicio de Interclases LJV">
      <img
        class="site-logo"
        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQjyPasuwCjM-T9wsh9KY8AYvZD7m4WFiufQGn7CtHjNLxS7BpOdR9xHB2v&s=10"
        alt="Logo de la Institución Educativa Lucrecio Jaramillo Vélez"
      >
      <div>
        <p class="eyebrow banner-season">LJV / TEMPORADA 2026</p>
        <h1>Interclases de futbol</h1>
        <p>Lucrecio Jaramillo Velez</p>
      </div>
    </a>

    <button class="nav-toggle" id="navToggle" type="button" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="primary-navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-menu" id="primary-navigation">
      <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/calendario">Calendario</a>
        <a href="/posiciones">Posiciones</a>
        <a href="/equipos">Equipos</a>
      </div>

      <div class="header-actions">
        <% if (user) { %>
          <details class="profile-menu">
            <summary class="profile-trigger">
              <svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="3.2"></circle>
                <path d="M5.5 20c.8-3.2 3-5 6.5-5s5.7 1.8 6.5 5"></path>
              </svg>
              <% const displayName = user.nombre || user.name || ''; %>
              <span class="profile-name profile-name--full"><%= displayName %></span>
              <span class="profile-name profile-name--first"><%= displayName.split(/\s+/)[0] || 'Perfil' %></span>
            </summary>
            <div class="profile-dropdown">
              <span class="profile-role"><%= user.role === 'admin' ? 'Administrador' : 'Estudiante' %></span>
              <a href="/">Ir al Inicio</a>
              <% if (user.role === 'admin') { %>
                <a href="/admin">Panel de Administrador</a>
              <% } %>
              <a href="/logout">Cerrar sesión</a>
            </div>
          </details>
        <% } else { %>
          <a class="btn btn-secondary login-button" href="/login">Iniciar sesión</a>
          <a class="btn btn-primary register-button" href="/registro">Registrarse</a>
        <% } %>
      </div>
    </div>
  </nav>
</header>
