<!doctype html>
<html lang="es">
  <%- include('partials/head', { title }) %>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card">
        <div class="auth-brand">
          <h1>Nueva contraseña</h1>
          <p>Crea una contraseña segura para volver a entrar a tu cuenta.</p>
        </div>

        <% if (error) { %><div class="auth-alert error"><%= error %></div><% } %>

        <% if (token) { %>
          <form class="auth-form" action="/reset-password/<%= token %>" method="post">
            <label>
              <span>Nueva contraseña</span>
              <span class="password-field">
                <input type="password" name="password" required>
                <button class="password-toggle" type="button" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false">
                  <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z"></path>
                    <circle cx="12" cy="12" r="2.5"></circle>
                    <line class="eye-slash" x1="4" y1="4" x2="20" y2="20"></line>
                  </svg>
                </button>
              </span>
            </label>
            <label>
              <span>Confirmar contraseña</span>
              <span class="password-field">
                <input type="password" name="confirmPassword" required>
                <button class="password-toggle" type="button" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false">
                  <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z"></path>
                    <circle cx="12" cy="12" r="2.5"></circle>
                    <line class="eye-slash" x1="4" y1="4" x2="20" y2="20"></line>
                  </svg>
                </button>
              </span>
            </label>
            <button type="submit">Guardar contraseña</button>
          </form>
        <% } %>

        <p class="auth-footer"><a href="/login">Volver a iniciar sesión</a></p>
      </section>
    </main>
    <%- include('partials/accessibility-settings') %>
    <script src="/js/password-toggle.js" defer></script>
  </body>
</html>