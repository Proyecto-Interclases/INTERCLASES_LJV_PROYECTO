<!doctype html>
<html lang="es">
  <%- include('partials/head', { title }) %>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card">
        <div class="auth-brand">
          <h1>Crear cuenta</h1>
          <p>Regístrate para participar en la comunidad deportiva del colegio.</p>
        </div>

        <% if (error) { %>
          <div class="auth-alert error"><%= error %></div>
        <% } %>

        <form class="auth-form" action="/register" method="post" data-register-form>
          <label>
            <span>Nombre completo</span>
            <input type="text" name="nombre" placeholder="Tu nombre" value="<%= formData.nombre || '' %>" minlength="3" pattern="[A-Za-zÁÉÍÓÚáéíóúÜüÑñ]+( [A-Za-zÁÉÍÓÚáéíóúÜüÑñ]+)*" title="Usa mínimo 3 caracteres, solo letras y espacios" required>
            <small class="field-help" data-name-feedback>Usa solo letras y espacios.</small>
          </label>

          <label>
            <span>Correo electrónico</span>
            <input type="email" name="email" placeholder="correo@ejemplo.com" value="<%= formData.email || '' %>" required>
          </label>

          <label>
            <span>Contraseña</span>
            <span class="password-field">
              <input type="password" name="password" placeholder="Ejemplo: FutbolLJV2026!" pattern="(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}" title="Mínimo 8 caracteres, una mayúscula, un número y un carácter especial" required>
              <button class="password-toggle" type="button" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false">
                <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z"></path>
                  <circle cx="12" cy="12" r="2.5"></circle>
                  <line class="eye-slash" x1="4" y1="4" x2="20" y2="20"></line>
                </svg>
              </button>
            </span>
            <small class="field-help">Ejemplo válido: FutbolLJV2026! (no uses este ejemplo como contraseña real).</small>
            <ul class="password-requirements" aria-live="polite">
              <li data-password-rule="length">Mínimo 8 caracteres</li>
              <li data-password-rule="uppercase">Una letra mayúscula</li>
              <li data-password-rule="number">Un número</li>
              <li data-password-rule="special">Un carácter especial</li>
            </ul>
          </label>

          <label>
            <span>Confirmar contraseña</span>
            <span class="password-field">
              <input type="password" name="confirmPassword" placeholder="Repite la contraseña" required>
              <button class="password-toggle" type="button" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false">
                <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z"></path>
                  <circle cx="12" cy="12" r="2.5"></circle>
                  <line class="eye-slash" x1="4" y1="4" x2="20" y2="20"></line>
                </svg>
              </button>
            </span>
            <small class="field-help" data-confirm-feedback>Las contraseñas deben coincidir.</small>
          </label>

          <button type="submit">Registrarme</button>
        </form>

        <p class="auth-footer">
          ¿Ya tienes cuenta?
          <a href="/login">Inicia sesión</a>
        </p>

        <a class="text-link" href="/">Volver al inicio</a>
      </section>
    </main>
    <%- include('partials/accessibility-settings') %>
    <script src="/js/password-toggle.js" defer></script>
    <script src="/js/register-validation.js" defer></script>
  </body>
</html>
