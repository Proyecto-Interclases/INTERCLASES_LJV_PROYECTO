<!doctype html>
<html lang="es">
<%- include('../partials/head', { title }) %>
<body class="sports-page teams-page">
  <%- include('../partials/navbar', { user }) %>

  <main class="container sports-main" id="main-content">
    <header class="sports-heading">
      <div>
        <p class="eyebrow section-eyebrow">PLANTILLAS · TORNEO 2026</p>
        <h1>Equipos y goleadores</h1>
        <p>Consulta las plantillas inscritas y el ranking de anotadores.</p>
      </div>
      <form class="sports-filter" action="/equipos" method="get">
        <input type="hidden" name="deporte" value="<%= selectedSport %>">
        <label for="teams-category">Categoría</label>
        <select id="teams-category" name="categoria" onchange="this.form.submit()">
          <option value="">Todas</option>
          <% categories.forEach((category) => { %>
            <option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option>
          <% }) %>
        </select>
        <label for="teams-order">Ordenar</label>
        <select id="teams-order" name="orden" onchange="this.form.submit()">
          <option value="desc" <%= selectedOrder === 'desc' ? 'selected' : '' %>>Grado: mayor a menor</option>
          <option value="asc" <%= selectedOrder === 'asc' ? 'selected' : '' %>>Grado: menor a mayor</option>
        </select>
      </form>
    </header>
    <%- include('../partials/sport-tabs', { sports, selectedSport }) %>

    <section class="sports-section" aria-labelledby="teams-title">
      <div class="sports-section-heading">
        <div>
          <p class="eyebrow section-eyebrow">CLUBES PARTICIPANTES</p>
          <h2 id="teams-title">Equipos</h2>
        </div>
        <span><%= teams.length %> equipo<%= teams.length === 1 ? '' : 's' %></span>
      </div>
      <% if (!teams.length) { %>
        <p class="sports-empty-block">Aún no hay equipos registrados en esta categoría.</p>
      <% } else { %>
        <div class="teams-grid">
          <% teams.forEach((team) => { %>
            <article class="team-card" data-team-grade="<%= team.grado %>" data-team-name="<%= team.nombre %>">
              <div class="team-card-top">
                <% if (team.escudoUrl) { %>
                  <img class="team-crest" src="<%= team.escudoUrl %>" alt="Escudo de <%= team.nombre %>" loading="lazy">
                <% } else { %>
                  <span class="team-crest team-crest--empty" aria-hidden="true"><%= team.nombre.slice(0, 1).toUpperCase() %></span>
                <% } %>
                <div>
                  <p class="eyebrow"><%= team.categoria %></p>
                  <h3><%= team.nombre %><% if (team.grado) { %> <span class="team-grade"><%= team.grado %></span><% } %></h3>
                  <p class="team-captain">Capitán: <%= team.capitanEmail || 'Por asignar' %></p>
                </div>
              </div>
              <details class="team-roster" data-roster-accordion>
                <summary><span data-roster-toggle-label>Desplegar plantilla</span><span class="team-roster-toggle-count"><%= team.jugadores.length %></span></summary>
                <% const topTeamGoals = team.jugadores.length ? Math.max(...team.jugadores.map((player) => Number(player.goles || 0))) : 0; %>
                <% if (selectedSport === 'futbol') { %>
                  <%
                    const fifaStarters = [];
                    team.alineacion.forEach((line) => {
                      line.players.forEach((player, index) => {
                        const fallbackPosition = line.id === 'attack' ? 'Delantero'
                          : line.id === 'goalkeeper' ? 'Portero'
                            : index === 0 ? 'Defensa' : 'Mediocampista';
                        fifaStarters.push({
                          ...player,
                          posicion: player.lineupRole && player.lineupRole !== 'Defensa / mediocampista'
                            ? player.lineupRole
                            : player.posicion || fallbackPosition,
                          titular: true
                        });
                      });
                    });
                    const fifaRoster = [
                      ...fifaStarters,
                      ...team.banca.map((player) => ({ ...player, titular: false }))
                    ];
                  %>
                  <section class="fifa-squad" data-fifa-squad="<%= JSON.stringify(fifaRoster) %>" aria-label="Plantilla de <%= team.nombre %>">
                    <p class="fifa-squad__title">Plantilla · <b>Once titular</b></p>
                    <div class="fifa-pitch" role="group" aria-label="Cancha de <%= team.nombre %>">
                      <div class="fifa-pitch__row" data-fifa-row="attack" role="group" aria-label="Delanteros"></div>
                      <div class="fifa-pitch__row" data-fifa-row="midfield" role="group" aria-label="Defensas y mediocampistas"></div>
                      <div class="fifa-pitch__row" data-fifa-row="goalkeeper" role="group" aria-label="Portero"></div>
                    </div>
                    <section class="team-bench" aria-labelledby="bench-<%= team._id %>">
                      <div class="team-bench__heading">
                        <h4 id="bench-<%= team._id %>">Suplentes</h4>
                        <span><%= team.banca.length %></span>
                      </div>
                      <div class="fifa-bench" data-fifa-bench aria-label="Jugadores suplentes"></div>
                    </section>
                    <% if (!team.jugadores.length) { %>
                      <p class="roster-empty">Aún no hay jugadores inscritos; las cinco posiciones están disponibles.</p>
                    <% } %>
                  </section>
                <% } else if (team.jugadores.length) { %>
                  <section class="team-roster__other-sport" aria-label="Plantilla de <%= team.nombre %>">
                    <% team.alineacion.forEach((line) => { if (line.players.length) { %>
                      <div class="other-sport-line">
                        <h4><%= line.label %></h4>
                        <ul class="player-card-row">
                          <% line.players.forEach((player) => { %>
                            <li><%- include('../partials/player-card', { player, compact: false, topTeamGoals }) %></li>
                          <% }) %>
                        </ul>
                      </div>
                    <% } }) %>
                  </section>
                <% } else { %>
                  <p class="roster-empty">La plantilla aún no tiene jugadores.</p>
                <% } %>
              </details>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="sports-section scorers-section" aria-labelledby="scorers-title">
      <div class="sports-section-heading">
        <div>
          <p class="eyebrow section-eyebrow">LÍDERES DEL TORNEO</p>
          <h2 id="scorers-title">Goleadores</h2>
        </div>
        <span>Top 10</span>
      </div>
      <div class="sports-table-wrap table-responsive">
        <table class="sports-table scorers-table">
          <thead>
            <tr>
              <th class="col-rank" scope="col">#</th>
              <th class="col-player" scope="col">Jugador</th>
              <th class="col-team" scope="col">Equipo</th>
              <th class="col-goals" scope="col">Goles</th>
            </tr>
          </thead>
          <tbody>
            <% if (!topScorers.length) { %>
              <tr><td colspan="4" class="sports-empty">Aún no hay goles individuales registrados.</td></tr>
            <% } else { %>
              <% topScorers.forEach((player, index) => { %>
                <tr>
                  <td class="col-rank standings-rank"><strong><%= String(index + 1).padStart(2, '0') %></strong></td>
                  <td class="col-player">
                    <div class="player-row-item">
                      <div class="mini-card-thumb">
                        <% if (player.fotoUrl) { %><img src="<%= player.fotoUrl %>" alt="Foto de <%= player.nombre %>" loading="lazy" decoding="async"><% } %>
                      </div>
                      <div class="player-info-text">
                        <span class="p-name"><%= player.nombre %></span>
                        <span class="p-grade"><%= player.grado %></span>
                      </div>
                    </div>
                  </td>
                  <td class="col-team">
                    <div class="team-cell-content">
                      <% if (player.escudoUrl) { %><img src="<%= player.escudoUrl %>" alt="Escudo de <%= player.equipo %>" class="team-logo-sm" loading="lazy" decoding="async"><% } %>
                      <span><%= player.equipo %></span>
                    </div>
                  </td>
                  <td class="col-goals"><span class="goal-badge"><%= player.goles %></span></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <%- include('../partials/accessibility-settings') %>
  <% if (selectedSport === 'futbol') { %>
    <script src="/js/fifa-roster.js?v=shirt-numbers-20261018" defer></script>
  <% } %>
</body>
</html>
