<!doctype html>
<html lang="es">
  <%- include('partials/head', { title }) %>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card">
        <div class="auth-brand">
          <h1>Recuperar contraseña</h1>
          <p>Ingresa tu correo y te enviaremos un enlace para crear una nueva contraseña.</p>
        </div>

        <% if (error) { %><div class="auth-alert error"><%= error %></div><% } %>
        <% if (success) { %><div class="auth-alert success"><%= success %></div><% } %>

        <form class="auth-form" action="/forgot-password" method="post">
          <label>
            <span>Correo electrónico</span>
            <input type="email" name="email" value="<%= formData.email || '' %>" required>
          </label>
          <button type="submit">Enviar enlace</button>
        </form>

        <p class="auth-footer"><a href="/login">Volver a iniciar sesión</a></p>
      </section>
    </main>
    <%- include('partials/accessibility-settings') %>
  </body>
</html>