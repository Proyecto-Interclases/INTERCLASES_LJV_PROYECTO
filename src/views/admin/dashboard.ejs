<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body class="dashboard-page">
    <header class="dashboard-header">
      <div>
        <p class="eyebrow">GESTIÓN DOCENTE</p>
        <h1>Panel del profesor</h1>
      </div>
      <div class="header-actions">
        <% const displayName = user.nombre || user.name || ''; %>
        <details class="profile-menu dashboard-profile-menu">
          <summary class="profile-trigger user-badge" aria-label="Abrir menú de usuario">
            <svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5.5 20c.8-3.2 3-5 6.5-5s5.7 1.8 6.5 5"></path>
            </svg>
            <span class="profile-name profile-name--full">Hola, <%= displayName %></span>
            <span class="profile-name profile-name--first">Hola, <%= displayName.split(/\s+/)[0] || 'Perfil' %></span>
          </summary>
          <div class="profile-dropdown">
            <span class="profile-role">Administrador</span>
            <a href="/">Ir al Inicio</a>
            <a href="/logout">Cerrar sesión</a>
          </div>
        </details>
      </div>
    </header>

    <main class="dashboard-shell">
      <aside class="dashboard-sidebar">
        <nav aria-label="Secciones de administración">
          <a href="#partidos">Partidos y resultados</a>
          <a href="#equipos">Equipos y plantilla</a>
          <a href="#posiciones">Tabla de posiciones</a>
          <a href="#anuncios">Noticias y avisos</a>
        </nav>
      </aside>

      <section class="dashboard-content">
        <% if (error) { %>
          <div class="auth-alert error" role="alert"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert success" role="status"><%= success %></div>
        <% } %>

        <section class="panel-card" id="partidos">
          <p class="eyebrow">PROGRAMACIÓN</p>
          <h2>Partidos y resultados</h2>
          <form class="dashboard-form" action="/admin/partidos" method="post">
            <div class="field-row">
              <label>Equipo local<select name="equipoLocalId" required><option value="">Selecciona</option><% equipos.forEach((equipo) => { %><option value="<%= equipo.id %>"><%= equipo.nombre %></option><% }) %></select></label>
              <label>Equipo visitante<select name="equipoVisitanteId" required><option value="">Selecciona</option><% equipos.forEach((equipo) => { %><option value="<%= equipo.id %>"><%= equipo.nombre %></option><% }) %></select></label>
            </div>
            <div class="field-row">
              <label>Fecha<input type="date" name="fechaPartido" required></label>
              <label>Hora<input type="time" name="horaPartido" required></label>
            </div>
            <div class="field-row">
              <label>Cancha<input type="text" name="cancha" placeholder="Cancha principal" required></label>
              <label>Estado<select name="estado"><% estadosPartido.forEach((estado) => { %><option value="<%= estado %>"><%= estado %></option><% }) %></select></label>
            </div>
            <button type="submit" class="btn btn-primary">+ Programar partido</button>
          </form>
        </section>

        <section class="panel-card" aria-labelledby="fixture-title">
          <h2 id="fixture-title">Partidos registrados</h2>
          <div class="result-list dashboard-list">
            <% if (!partidos.length) { %>
              <p>No hay partidos registrados.</p>
            <% } else { %>
              <% partidos.forEach((partido) => { %>
                <form class="result-item match-admin-item" action="/admin/partidos/<%= partido.id %>/editar" method="post">
                  <div class="match-admin-teams"><strong><%= partido.equipo_local %></strong><span>vs.</span><strong><%= partido.equipo_visitante %></strong><small><%= partido.goles_local %> - <%= partido.goles_visitante %></small></div>
                  <div class="inline-fields">
                    <input type="date" name="fechaPartido" value="<%= partido.fecha_partido %>" required>
                    <input type="time" name="horaPartido" value="<%= partido.hora_partido %>" required>
                    <input type="text" name="cancha" value="<%= partido.cancha || '' %>" placeholder="Cancha" required>
                    <input type="hidden" name="equipoLocalId" value="<%= partido.equipo_local_id %>">
                    <input type="hidden" name="equipoVisitanteId" value="<%= partido.equipo_visitante_id %>">
                    <select name="estado"><% estadosPartido.forEach((estado) => { %><option value="<%= estado %>" <%= partido.estado === estado ? 'selected' : '' %>><%= estado %></option><% }) %></select>
                    <button type="submit" class="btn btn-secondary dark">Actualizar</button>
                  </div>
                </form>
                <div class="result-item">
                  <span>Marcador: <strong><%= partido.resultado %></strong></span>
                  <form action="/admin/partidos/<%= partido.id %>/resultados" method="post" class="score-form">
                    <input type="number" name="golesLocal" min="0" value="<%= partido.goles_local ?? 0 %>" required>
                    <span>-</span>
                    <input type="number" name="golesVisitante" min="0" value="<%= partido.goles_visitante ?? 0 %>" required>
                    <button type="submit" class="btn btn-secondary dark">Guardar marcador</button>
                  </form>
                  <form action="/admin/partidos/<%= partido.id %>/eliminar" method="post"><button type="submit" class="btn btn-danger">Eliminar</button></form>
                </div>
              <% }) %>
            <% } %>
          </div>
        </section>

        <section class="panel-card" id="equipos">
          <p class="eyebrow">PLANTILLAS DEL TORNEO</p>
          <h2>Equipos y jugadores</h2>
          <form class="dashboard-form" action="/admin/equipos" method="post" enctype="multipart/form-data">
            <div class="field-row">
              <label>Nombre del equipo<input type="text" name="nombre" required></label>
              <label>Curso o categoría<input type="text" name="categoria" required></label>
            </div>
            <div class="field-row">
              <label>Subir escudo (JPG, PNG o WebP)<input type="file" name="escudo" accept="image/jpeg,image/png,image/webp"></label>
              <label>URL del escudo<input type="url" name="escudoUrl" placeholder="https://..." inputmode="url"></label>
            </div>
            <div class="field-row">
              <label>Correo del capitán<input type="email" name="emailCapitan" placeholder="capitan@colegio.edu.co"></label>
            </div>
            <button type="submit" class="btn btn-primary">+ Agregar nuevo equipo</button>
          </form>
          <div class="result-list dashboard-list">
            <% if (!equipos.length) { %>
              <p>Aún no hay equipos creados.</p>
            <% } else { %>
              <% equipos.forEach((equipo) => { %>
                <article class="result-item admin-team-item">
                  <div class="admin-team-heading">
                    <% if (equipo.escudoUrl) { %>
                      <img class="admin-team-crest" src="<%= equipo.escudoUrl %>" alt="Escudo de <%= equipo.nombre %>" loading="lazy">
                    <% } else { %>
                      <span class="admin-team-crest admin-team-crest--empty" aria-hidden="true"><%= equipo.nombre.slice(0, 1).toUpperCase() %></span>
                    <% } %>
                    <div><strong><%= equipo.nombre %></strong><small><%= equipo.categoria %> · Capitán: <%= equipo.capitanEmail || 'Por asignar' %></small></div>
                  </div>
                  <div class="admin-roster">
                    <strong>Plantilla</strong>
                    <% const teamPlayers = jugadores.filter((jugador) => jugador.equipo_id === equipo.id); %>
                    <% if (!teamPlayers.length) { %>
                      <p class="form-hint">Todavía no hay jugadores para este equipo.</p>
                    <% } else { %>
                      <% teamPlayers.forEach((jugador) => { %>
                        <div class="admin-roster-player">
                          <span class="roster-number"><%= jugador.numero_camiseta %></span>
                          <span><strong><%= jugador.nombre %></strong><small><%= jugador.posicion %></small></span>
                          <form class="goal-update-form" action="/admin/jugadores/<%= jugador.id %>/goles" method="post">
                            <label>Goles<input type="number" name="goles" min="0" step="1" value="<%= jugador.goles %>" required></label>
                            <button type="submit" class="btn btn-secondary dark">Guardar</button>
                          </form>
                          <form action="/admin/jugadores/<%= jugador.id %>/eliminar" method="post"><button type="submit" class="btn btn-danger">Eliminar</button></form>
                        </div>
                      <% }) %>
                    <% } %>
                  </div>
                </article>
              <% }) %>
            <% } %>
          </div>
          <div class="admin-player-create" id="plantillas">
            <h3>Agregar jugador a una plantilla</h3>
            <form class="dashboard-form" action="/admin/jugadores" method="post">
              <div class="field-row">
                <label>Equipo<select name="equipo_id" required><option value="">Selecciona un equipo</option><% equipos.forEach((equipo) => { %><option value="<%= equipo.id %>"><%= equipo.nombre %> · <%= equipo.categoria %></option><% }) %></select></label>
                <label>Jugador<input type="text" name="nombre" required></label>
              </div>
              <div class="field-row">
                <label>Número de camiseta<input type="number" name="numero_camiseta" min="0" max="99" value="0" required></label>
                <label>Posición<input type="text" name="posicion" placeholder="Defensa, delantero..."></label>
              </div>
              <div class="field-row">
                <label>Goles iniciales<input type="number" name="goles" min="0" value="0" required></label>
              </div>
              <button type="submit" class="btn btn-primary">+ Agregar jugador</button>
            </form>
          </div>
        </section>

        <section class="panel-card" id="posiciones">
          <p class="eyebrow">CÁLCULO AUTOMÁTICO</p>
          <h2>Tabla de posiciones</h2>
          <div class="sports-table-wrap">
            <table class="sports-table standings-table">
              <thead><tr><th scope="col">#</th><th scope="col">Equipo</th><th scope="col">PJ</th><th scope="col">PG</th><th scope="col">PE</th><th scope="col">PP</th><th scope="col">GF</th><th scope="col">GC</th><th scope="col">DG</th><th scope="col">Pts</th></tr></thead>
              <tbody>
                <% if (!posiciones.length) { %>
                  <tr><td colspan="10" class="sports-empty">Se calculará cuando se registren equipos y resultados finales.</td></tr>
                <% } else { %>
                  <% posiciones.forEach((equipo, index) => { %>
                    <tr><td class="standings-rank"><%= index + 1 %></td><th scope="row"><%= equipo.name %><small><%= equipo.category %></small></th><td><%= equipo.played %></td><td><%= equipo.won %></td><td><%= equipo.drawn %></td><td><%= equipo.lost %></td><td><%= equipo.goalsFor %></td><td><%= equipo.goalsAgainst %></td><td><%= equipo.goalDifference %></td><td class="standings-points"><%= equipo.points %></td></tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel-card" id="anuncios">
          <p class="eyebrow">COMUNICACIÓN</p>
          <h2>Noticias y avisos</h2>
          <form class="dashboard-form" action="/admin/popup" method="post">
            <label>Título<input type="text" name="titulo" value="<%= popup.titulo %>" required></label>
            <label>Mensaje<textarea name="mensaje" rows="4" required><%= popup.mensaje %></textarea></label>
            <label class="check-field"><input type="checkbox" name="activo" value="1" <%= popup.activo ? 'checked' : '' %>>Mostrar aviso destacado en la página principal</label>
            <button type="submit" class="btn btn-primary">Publicar aviso</button>
          </form>
        </section>
        <details class="panel-card admin-users" id="usuarios">
          <summary>Usuarios registrados</summary>
          <div class="result-list dashboard-list">
            <% if (!usuarios.length) { %>
              <p>No hay usuarios registrados.</p>
            <% } else { %>
              <% usuarios.forEach((usuario) => { %>
                <div class="result-item">
                  <div>
                    <strong><%= usuario.nombre %></strong>
                    <small><%= usuario.email %> · <%= usuario.role %><%= usuario.teamName ? ` · ${usuario.teamName}` : '' %></small>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </details>
      </section>
    </main>
    <%- include('../partials/accessibility-settings') %>
  </body>
</html>
