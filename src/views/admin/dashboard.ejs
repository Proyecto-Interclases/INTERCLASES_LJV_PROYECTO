<!doctype html>
<html lang="es">
  <%- include('../partials/head', { title }) %>
  <body class="dashboard-page">
    <header class="dashboard-header">
      <div>
        <p class="eyebrow">PANEL DE ADMINISTRACIÓN</p>
        <h1>Interclases Lucrecio Jaramillo</h1>
      </div>
      <div class="header-actions">
        <% const displayName = user.nombre || user.name || ''; %>
        <details class="profile-menu dashboard-profile-menu">
          <summary class="profile-trigger user-badge" aria-label="Abrir menú de usuario">
            <svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5.5 20c.8-3.2 3-5 6.5-5s5.7 1.8 6.5 5"></path>
            </svg>
            <span class="profile-name profile-name--full">Hola, <%= displayName %></span>
            <span class="profile-name profile-name--first">Hola, <%= displayName.split(/\s+/)[0] || 'Perfil' %></span>
          </summary>
          <div class="profile-dropdown">
            <span class="profile-role">Administrador</span>
            <a href="/">Ir al Inicio</a>
            <a href="/logout">Cerrar sesión</a>
          </div>
        </details>
      </div>
    </header>

    <main class="dashboard-shell">
      <aside class="dashboard-sidebar">
        <button class="admin-navigation-toggle" type="button" aria-expanded="false" aria-controls="admin-section-navigation" aria-label="Mostrar secciones de administración" hidden>
          <span data-active-admin-section>Equipos y jugadores</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <nav class="admin-section-nav" id="admin-section-navigation" aria-label="Secciones de administración" aria-hidden="false" role="tablist" aria-orientation="vertical">
          <button type="button" role="tab" id="admin-tab-teams" aria-controls="equipos" aria-selected="true" tabindex="0" data-admin-tab="teams">Equipos y jugadores</button>
          <button type="button" role="tab" id="admin-tab-enrollments" aria-controls="inscripciones" aria-selected="false" tabindex="-1" data-admin-tab="enrollments">Inscripciones <%= enrollmentRequests.filter((item) => item.estado === 'pendiente').length %></button>
          <button type="button" role="tab" id="admin-tab-matches" aria-controls="partidos" aria-selected="false" tabindex="-1" data-admin-tab="matches">Partidos y resultados</button>
          <button type="button" role="tab" id="admin-tab-standings" aria-controls="posiciones" aria-selected="false" tabindex="-1" data-admin-tab="standings">Tabla de posiciones</button>
          <button type="button" role="tab" id="admin-tab-announcements" aria-controls="anuncios" aria-selected="false" tabindex="-1" data-admin-tab="announcements">Anuncios y noticias</button>
          <button type="button" role="tab" id="admin-tab-gallery" aria-controls="galeria" aria-selected="false" tabindex="-1" data-admin-tab="gallery">Galería / Carrusel</button>
          <button type="button" role="tab" id="admin-tab-users" aria-controls="usuarios" aria-selected="false" tabindex="-1" data-admin-tab="users">Usuarios</button>
        </nav>
      </aside>

      <section class="dashboard-content">
        <% if (error) { %>
          <div class="auth-alert error" role="alert"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert success" role="status"><%= success %></div>
        <% } %>
        <section class="admin-kpis" aria-label="Resumen del torneo">
          <article><span>Equipos inscritos</span><strong data-kpi="teams"><%= kpis.equipos %></strong><small>En la selección actual</small></article>
          <article><span>Partidos pendientes</span><strong data-kpi="matches"><%= kpis.partidosPendientes %></strong><small>Por jugar o en curso</small></article>
          <article><span>Goles registrados</span><strong data-kpi="goals"><%= kpis.goles %></strong><small>En las plantillas visibles</small></article>
          <article><span>Anuncios activos</span><strong><%= kpis.anunciosActivos %></strong><small>Visible en la página principal</small></article>
        </section>
        <section class="admin-scope-filter" data-admin-sport-scope aria-label="Seleccionar deporte y categoría">
          <fieldset class="admin-sport-picker">
            <legend>Selecciona un deporte</legend>
            <% sports.forEach((sport) => { %>
              <button type="button" class="admin-sport-card" data-admin-sport-choice="<%= sport.id %>" aria-pressed="<%= (selectedSport || 'futbol') === sport.id ? 'true' : 'false' %>">
                <span><%= sport.name %></span><small>Ver torneo</small>
              </button>
            <% }) %>
          </fieldset>
          <label>Categoría
            <select data-admin-category-filter aria-label="Filtrar por categoría">
              <option value="">Todas las categorías</option>
              <% categoriasEquipo.forEach((categoria) => { %><option value="<%= categoria %>" <%= selectedCategory === categoria ? 'selected' : '' %>><%= categoria %></option><% }) %>
            </select>
          </label>
          <p data-admin-scope-status role="status" aria-live="polite">Cargando datos del torneo…</p>
          <div class="admin-scope-error" data-admin-scope-error role="alert" hidden></div>
        </section>

        <section class="panel-card admin-tab-panel" id="inscripciones" data-admin-panel="enrollments" role="tabpanel" aria-labelledby="admin-tab-enrollments" hidden>
          <div class="admin-section-toolbar"><div><p class="eyebrow">CONVOCATORIA</p><h2>Inscripciones</h2></div></div>
          <p class="form-hint">Al abrirlas, los estudiantes podrán inscribir equipos en fútbol, baloncesto o voleibol.</p>
          <form class="enrollment-admin-setting" action="/admin/inscripciones/disponibilidad" method="post" data-enrollment-toggle>
            <label class="enrollment-toggle">
              <input type="checkbox" name="inscripcionesAbiertas" value="true" <%= enrollmentConfig.inscripcionesAbiertas ? 'checked' : '' %>>
              <span class="enrollment-toggle__track" aria-hidden="true"></span>
              <span class="enrollment-toggle__copy"><strong>Inscripciones <%= enrollmentConfig.inscripcionesAbiertas ? 'abiertas' : 'cerradas' %></strong><small>Controla la recepción de solicitudes para los tres deportes.</small></span>
            </label>
            <button class="admin-quiet-button" type="submit">Guardar estado</button>
            <p class="enrollment-toggle__feedback" role="status" aria-live="polite"></p>
          </form>
          <div class="admin-section-toolbar enrollment-requests-heading"><div><p class="eyebrow">SOLICITUDES</p><h2>Solicitudes recibidas</h2></div><span><%= enrollmentRequests.filter((item) => item.estado === 'pendiente').length %> pendientes</span></div>
          <% if (!enrollmentRequests.length) { %>
            <p class="sports-empty-block">Todavía no hay solicitudes de inscripción.</p>
          <% } else { %>
            <div class="enrollment-request-list">
              <% enrollmentRequests.forEach((request) => { %>
                <article class="enrollment-request-card" data-admin-sport="<%= request.deporte || 'futbol' %>" data-admin-category="<%= request.categoria || '' %>">
                  <div class="enrollment-request-title"><div><p class="eyebrow"><%= sports.find((sport) => sport.id === request.deporte)?.name || request.deporte %> · <%= request.categoria %></p><h3><%= request.nombreEquipo %></h3></div><span class="enrollment-status enrollment-status--<%= request.estado %>"><%= request.estado %></span></div>
                  <p><strong>Grado/sección:</strong> <%= request.grado %> · <strong>Responsable:</strong> <%= request.responsable %> · <strong>Contacto:</strong> <%= request.contacto %></p>
                  <details><summary>Ver plantilla (<%= request.jugadores.length %>)</summary><ul><% request.jugadores.forEach((player) => { %><li><strong>#<%= player.numero_camiseta %></strong> <%= player.nombre %></li><% }) %></ul></details>
                  <% if (request.estado === 'pendiente') { %>
                    <div class="enrollment-request-actions">
                      <form action="/admin/inscripciones/<%= request._id %>/aprobar" method="post" onsubmit="return confirm('¿Aprobar la solicitud y crear el equipo con todos sus jugadores?')"><button class="btn btn-primary" type="submit">Aprobar y crear equipo</button></form>
                      <form action="/admin/inscripciones/<%= request._id %>/rechazar" method="post" onsubmit="return confirm('¿Rechazar esta solicitud?')"><button class="admin-quiet-button" type="submit">Rechazar</button></form>
                    </div>
                  <% } %>
                  <form action="/admin/inscripciones/<%= request._id %>/eliminar" method="post" onsubmit="return confirm('¿Eliminar definitivamente esta solicitud?')"><button class="admin-delete-team" type="submit">Eliminar solicitud</button></form>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>

        <section class="panel-card admin-tab-panel" id="partidos" data-admin-panel="matches" role="tabpanel" aria-labelledby="admin-tab-matches" hidden>
          <div class="admin-section-toolbar">
            <div><p class="eyebrow">PROGRAMACIÓN</p><h2>Partidos y resultados</h2></div>
            <button class="btn btn-primary" type="button" data-modal-open="match-editor-modal" data-match-create>+ Programar partido</button>
          </div>
        </section>

        <section class="panel-card admin-tab-panel" data-admin-panel="matches" role="tabpanel" aria-labelledby="admin-tab-matches" hidden>
          <div class="admin-section-toolbar">
            <div><p class="eyebrow">CALENDARIO</p><h2 id="fixture-title">Partidos registrados</h2></div>
            <div class="admin-table-tools"><input type="search" data-filter-target=".match-admin-item" placeholder="Buscar partido..." aria-label="Buscar partidos">
              <select data-filter-status aria-label="Filtrar partidos por estado"><option value="">Todos los estados</option><% estadosPartido.forEach((estado) => { %><option value="<%= estado %>"><%= estado %></option><% }) %></select>
            </div>
          </div>
          <div class="result-list dashboard-list">
            <% if (!partidos.length) { %>
              <p>No hay partidos registrados.</p>
            <% } else { %>
              <% partidos.forEach((partido) => { %>
                <article class="match-admin-item" data-match-status="<%= partido.estado %>" data-admin-sport="<%= partido.deporte || 'futbol' %>" data-admin-category="<%= partido.categoria || '' %>">
                <div class="result-item">
                  <div class="match-admin-teams"><strong><%= partido.equipo_local %></strong><span>vs.</span><strong><%= partido.equipo_visitante %></strong><small><%= partido.goles_local %> - <%= partido.goles_visitante %></small></div>
                  <span><%= sports.find((sport) => sport.id === partido.deporte)?.name || 'Fútbol' %> · <%= partido.fecha_partido %> · <%= partido.hora_partido %> · <%= partido.cancha %> · <%= partido.estado %></span>
                  <button class="btn btn-secondary dark" type="button" data-modal-open="match-editor-modal"
                    data-match-id="<%= partido.id %>" data-match-home-id="<%= partido.equipo_local_id || '' %>"
                    data-match-away-id="<%= partido.equipo_visitante_id || '' %>" data-match-date="<%= partido.fecha_partido %>"
                    data-match-time="<%= partido.hora_partido %>" data-match-venue="<%= partido.cancha || '' %>"
                    data-match-status="<%= partido.estado %>">Editar partido</button>
                </div>
                <div class="result-item">
                  <span>Marcador: <strong><%= partido.resultado %></strong></span>
                  <form action="/admin/partidos/<%= partido.id %>/resultados" method="post" class="score-form">
                    <input type="number" name="golesLocal" min="0" value="<%= partido.goles_local ?? 0 %>" required>
                    <span>-</span>
                    <input type="number" name="golesVisitante" min="0" value="<%= partido.goles_visitante ?? 0 %>" required>
                    <button type="submit" class="btn btn-secondary dark">Guardar marcador</button>
                  </form>
                  <form action="/admin/partidos/<%= partido.id %>/eliminar" method="post"><button type="submit" class="btn btn-danger">Eliminar</button></form>
                </div>
                </article>
              <% }) %>
            <% } %>
          </div>
          <dialog class="admin-modal" id="match-editor-modal" aria-labelledby="match-editor-title">
            <div class="admin-modal__surface">
              <div class="admin-modal__heading">
                <div><p class="eyebrow">CALENDARIO</p><h2 id="match-editor-title">Programar partido</h2></div>
                <button class="icon-action" type="button" data-modal-close aria-label="Cerrar formulario">&times;</button>
              </div>
              <form class="dashboard-form admin-modal__form" id="match-editor-form" action="/admin/partidos" method="post">
                <div class="field-row">
                  <label>Equipo local *<select name="equipoLocalId" id="match-editor-home" required><option value="">Selecciona</option><% equipos.forEach((equipo) => { %><option value="<%= equipo.id %>" data-sport="<%= equipo.deporte || 'futbol' %>" data-category="<%= equipo.categoria %>"><%= sports.find((sport) => sport.id === equipo.deporte)?.name || 'Fútbol' %> · <%= equipo.categoria %> · <%= equipo.nombre %></option><% }) %></select></label>
                  <label>Equipo visitante *<select name="equipoVisitanteId" id="match-editor-away" required><option value="">Selecciona</option><% equipos.forEach((equipo) => { %><option value="<%= equipo.id %>" data-sport="<%= equipo.deporte || 'futbol' %>" data-category="<%= equipo.categoria %>"><%= sports.find((sport) => sport.id === equipo.deporte)?.name || 'Fútbol' %> · <%= equipo.categoria %> · <%= equipo.nombre %></option><% }) %></select></label>
                </div>
                <div class="field-row">
                  <label>Fecha *<input type="date" name="fechaPartido" id="match-editor-date" required></label>
                  <label>Hora *<input type="time" name="horaPartido" id="match-editor-time" required></label>
                </div>
                <div class="field-row">
                  <label>Cancha *<input type="text" name="cancha" id="match-editor-venue" placeholder="Cancha principal" required></label>
                  <label>Estado<select name="estado" id="match-editor-status"><% estadosPartido.forEach((estado) => { %><option value="<%= estado %>"><%= estado %></option><% }) %></select></label>
                </div>
                <div class="admin-modal__actions"><button class="admin-quiet-button" type="button" data-modal-close>Cancelar</button><button type="submit" class="btn btn-primary">Guardar partido</button></div>
              </form>
            </div>
          </dialog>
        </section>

        <section class="panel-card admin-tab-panel" id="equipos" data-admin-panel="teams" role="tabpanel" aria-labelledby="admin-tab-teams">
          <div class="admin-section-toolbar">
            <div>
              <p class="eyebrow">PLANTILLAS DEL TORNEO</p>
              <h2>Equipos y jugadores</h2>
            </div>
            <button class="btn btn-primary" type="button" data-modal-open="team-create-modal">+ Crear equipo</button>
          </div>

          <dialog class="admin-modal" id="team-create-modal" aria-labelledby="team-create-title">
            <div class="admin-modal__surface">
              <div class="admin-modal__heading">
                <div><p class="eyebrow">TORNEO</p><h2 id="team-create-title">Crear equipo</h2></div>
                <button class="icon-action" type="button" data-modal-close aria-label="Cerrar formulario">&times;</button>
              </div>
              <form class="dashboard-form admin-modal__form" action="/admin/equipos" method="post" enctype="multipart/form-data">
                <div class="field-row">
                  <label>Nombre del equipo *<input type="text" name="nombre" required></label>
                  <label>Categoría *<select name="categoria" required><% categoriasEquipo.forEach((categoria) => { %><option value="<%= categoria %>"><%= categoria %></option><% }) %></select></label>
                  <label>Deporte *<select name="deporte" required><% sports.forEach((sport) => { %><option value="<%= sport.id %>"><%= sport.name %></option><% }) %></select></label>
                </div>
                <div class="field-row">
                  <label>Subir escudo (JPG, PNG o WebP)<input type="file" name="escudo" accept="image/jpeg,image/png,image/webp"></label>
                  <label>URL del escudo<input type="url" name="escudoUrl" placeholder="https://..." inputmode="url"></label>
                </div>
                <label>Capitán del equipo
                  <select name="emailCapitan">
                    <option value="">Sin asignar</option>
                    <% usuarios.filter((usuario) => usuario.role === 'student' && !usuario.teamName).forEach((usuario) => { %>
                      <option value="<%= usuario.email %>"><%= usuario.nombre %> · <%= usuario.email %></option>
                    <% }) %>
                  </select>
                </label>
                <div class="admin-modal__actions">
                  <button class="admin-quiet-button" type="button" data-modal-close>Cancelar</button>
                  <button type="submit" class="btn btn-primary">Guardar equipo</button>
                </div>
              </form>
            </div>
          </dialog>

          <dialog class="admin-modal" id="captain-editor-modal" aria-labelledby="captain-editor-title">
            <div class="admin-modal__surface">
              <div class="admin-modal__heading">
                <div><p class="eyebrow" id="captain-editor-team">EQUIPO</p><h2 id="captain-editor-title">Asignar capitán</h2></div>
                <button class="icon-action" type="button" data-modal-close aria-label="Cerrar formulario">&times;</button>
              </div>
              <form class="dashboard-form admin-modal__form" id="captain-editor-form" action="#" method="post">
                <label>Estudiante responsable
                  <select name="emailCapitan" id="captain-editor-select">
                    <option value="">Sin asignar capitán</option>
                    <% usuarios.filter((usuario) => usuario.role === 'student').forEach((usuario) => { %>
                      <option value="<%= usuario.email %>" data-assigned-team="<%= usuario.teamName || '' %>"><%= usuario.nombre %> · <%= usuario.email %><%= usuario.teamName ? ` · Asignado a ${usuario.teamName}` : '' %></option>
                    <% }) %>
                  </select>
                </label>
                <p class="form-hint">Solo se puede asignar un estudiante que todavía no sea capitán de otro equipo.</p>
                <div class="admin-modal__actions">
                  <button class="admin-quiet-button" type="button" data-modal-close>Cancelar</button>
                  <button type="submit" class="btn btn-primary">Guardar capitán</button>
                </div>
              </form>
            </div>
          </dialog>

          <dialog class="admin-modal" id="team-editor-modal" aria-labelledby="team-editor-title">
            <div class="admin-modal__surface">
              <div class="admin-modal__heading"><div><p class="eyebrow">TORNEO</p><h2 id="team-editor-title">Editar equipo</h2></div><button class="icon-action" type="button" data-modal-close aria-label="Cerrar formulario">&times;</button></div>
              <form class="dashboard-form admin-modal__form" id="team-editor-form" action="#" method="post" enctype="multipart/form-data">
                <div class="field-row"><label>Nombre *<input type="text" name="nombre" id="team-editor-name" maxlength="80" required></label><label>Categoría *<select name="categoria" id="team-editor-category" required><% categoriasEquipo.forEach((categoria) => { %><option value="<%= categoria %>"><%= categoria %></option><% }) %></select></label><label>Deporte *<select name="deporte" id="team-editor-sport" required><% sports.forEach((sport) => { %><option value="<%= sport.id %>"><%= sport.name %></option><% }) %></select></label></div>
                <div class="team-editor-crest-preview">
                  <img class="admin-team-crest" id="team-editor-crest-preview" alt="Escudo del equipo" hidden>
                  <span class="form-hint">Vista previa del escudo actual</span>
                </div>
                <div class="field-row"><label>Subir escudo<input type="file" name="escudo" accept="image/jpeg,image/png,image/webp"></label><label>URL HTTPS del escudo<input type="url" name="escudoUrl" id="team-editor-shield" placeholder="https://..."></label></div>
                <div class="admin-modal__actions"><button class="admin-quiet-button" type="button" data-modal-close>Cancelar</button><button class="btn btn-primary" type="submit">Guardar cambios</button></div>
              </form>
            </div>
          </dialog>

          <div class="admin-table-tools admin-team-filter">
            <label for="admin-team-order">Ordenar por grado</label>
            <select id="admin-team-order" data-admin-team-order aria-label="Ordenar equipos por grado">
              <option value="desc" <%= selectedOrder === 'desc' ? 'selected' : '' %>>Mayor a menor</option>
              <option value="asc" <%= selectedOrder === 'asc' ? 'selected' : '' %>>Menor a mayor</option>
            </select>
            <input type="search" data-filter-target=".admin-team-item" placeholder="Buscar equipo o categoría..." aria-label="Buscar equipos">
          </div>
          <div class="result-list dashboard-list">
            <% if (!equipos.length) { %>
              <p>Aún no hay equipos creados.</p>
            <% } else { %>
              <% equipos.forEach((equipo) => { %>
                <article class="result-item admin-team-item" data-team-grade="<%= equipo.gradoPrincipal || '' %>" data-team-name="<%= equipo.nombre %>" data-admin-sport="<%= equipo.deporte || 'futbol' %>" data-admin-category="<%= equipo.categoria || '' %>" data-search="<%= `${equipo.nombre} ${equipo.categoria} ${equipo.capitanNombre || ''}`.toLowerCase() %>">
                  <div class="admin-team-heading">
                    <% if (equipo.escudoUrl) { %>
                      <img class="admin-team-crest" src="<%= equipo.escudoUrl %>" alt="Escudo de <%= equipo.nombre %>" loading="lazy">
                    <% } else { %>
                      <span class="admin-team-crest admin-team-crest--empty" aria-hidden="true"><%= equipo.nombre.slice(0, 1).toUpperCase() %></span>
                    <% } %>
                    <div><strong><%= equipo.nombre %><% if (equipo.gradoPrincipal) { %> <span class="admin-team-primary-grade">· <%= equipo.gradoPrincipal %></span><% } %></strong><small><%= sports.find((sport) => sport.id === equipo.deporte)?.name || 'Fútbol' %> · <%= equipo.categoria %> · Capitán: <%= equipo.capitanNombre || 'Sin asignar' %></small><% if (equipo.capitanEmail) { %><small><%= equipo.capitanEmail %></small><% } %></div>
                  </div>
                  <div class="admin-team-actions">
                    <button class="admin-change-captain" type="button" data-modal-open="team-editor-modal" data-team-id="<%= equipo.id %>" data-team-name="<%= equipo.nombre %>" data-team-category="<%= equipo.categoria %>" data-team-sport="<%= equipo.deporte || 'futbol' %>" data-team-crest="<%= equipo.escudoUrl || '' %>">Editar equipo</button>
                    <button class="admin-change-captain" type="button" data-modal-open="captain-editor-modal" data-team-id="<%= equipo.id %>" data-team-name="<%= equipo.nombre %>" data-captain-email="<%= equipo.capitanEmail || '' %>"><%= equipo.capitanEmail ? 'Cambiar capitán' : 'Asignar capitán' %></button>
                    <button class="admin-add-player" type="button" data-modal-open="player-editor-modal" data-team-id="<%= equipo.id %>" data-team-name="<%= equipo.nombre %>">+ Agregar jugador</button>
                    <form action="/admin/equipos/<%= equipo.id %>/eliminar" method="post" onsubmit="return confirm('Solo se eliminará el equipo si no tiene jugadores ni partidos asociados. ¿Continuar?')"><button class="admin-delete-team" type="submit">Eliminar equipo</button></form>
                  </div>
                  <% const teamPlayers = jugadores.filter((jugador) => jugador.equipo_id === equipo.id); %>
                  <details class="admin-roster" data-roster-accordion>
                    <summary class="admin-roster-heading"><strong data-roster-toggle-label>Desplegar plantilla</strong><span class="admin-roster-count"><%= teamPlayers.length %> jugadores</span></summary>
                    <div class="admin-roster-content">
                    <% if (teamPlayers.length) { %><input class="admin-player-search" type="search" placeholder="Buscar jugador en <%= equipo.nombre %>..." aria-label="Buscar jugadores de <%= equipo.nombre %>" data-roster-search><% } %>
                    <% if (!teamPlayers.length) { %>
                      <p class="form-hint">Todavía no hay jugadores para este equipo.</p>
                    <% } else { %>
                      <div class="admin-roster-table-wrap">
                        <table class="admin-roster-table">
                          <thead><tr><th scope="col">Jugador</th><th scope="col">Grado / sección</th><th scope="col">Posición</th><th scope="col">Camiseta</th><th scope="col">Goles</th><th scope="col">Acciones</th></tr></thead>
                          <tbody>
                            <% teamPlayers.forEach((jugador) => { %>
                              <tr>
                                <td data-label="Jugador">
                                  <span class="admin-player-avatar" aria-hidden="true"><% if (jugador.fotoUrl) { %><img src="<%= jugador.fotoUrl %>" alt="" loading="lazy"><% } else { %><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.2"></circle><path d="M5.5 20c.8-3.2 3-5 6.5-5s5.7 1.8 6.5 5"></path></svg><% } %></span>
                                  <strong><%= jugador.nombre %></strong>
                                </td>
                                <td data-label="Grado / sección"><span class="admin-player-grade"><%= jugador.grado %></span></td>
                                <td data-label="Posición"><%= jugador.posicion || '—' %></td>
                                <td data-label="Camiseta">
                                  <input class="admin-roster-number" type="number" name="numero_camiseta" min="0" max="99" step="1" value="<%= jugador.numero_camiseta %>" aria-label="Número de camiseta de <%= jugador.nombre %>" data-roster-number data-player-id="<%= jugador.id %>" data-initial-value="<%= jugador.numero_camiseta %>" required>
                                </td>
                                <td data-label="Goles">
                                  <form class="goal-update-form" action="/admin/jugadores/<%= jugador.id %>/goles" method="post">
                                    <input type="number" name="goles" min="0" step="1" value="<%= jugador.goles %>" aria-label="Goles de <%= jugador.nombre %>" data-roster-goals data-player-id="<%= jugador.id %>" data-initial-value="<%= jugador.goles %>" required>
                                    <button class="icon-action" type="submit" aria-label="Guardar goles de <%= jugador.nombre %>" title="Guardar goles">
                                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 4 4L19 6"></path></svg>
                                    </button>
                                  </form>
                                </td>
                                <td data-label="Acciones">
                                  <div class="admin-player-actions">
                                    <button class="icon-action" type="button" data-modal-open="player-editor-modal" data-player-id="<%= jugador.id %>" data-team-id="<%= equipo.id %>" data-team-name="<%= equipo.nombre %>" data-player-name="<%= jugador.nombre %>" data-player-grade="<%= jugador.grado %>" data-player-position="<%= jugador.posicion %>" data-player-number="<%= jugador.numero_camiseta %>" data-player-goals="<%= jugador.goles %>" data-player-photo="<%= jugador.fotoUrl || '' %>" aria-label="Editar a <%= jugador.nombre %>" title="Editar jugador">
                                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>
                                    </button>
                                    <form action="/admin/jugadores/<%= jugador.id %>/eliminar" method="post" onsubmit="return confirm('¿Eliminar a <%= jugador.nombre %> de la plantilla?')">
                                      <button class="icon-action icon-action--danger" type="submit" aria-label="Eliminar a <%= jugador.nombre %>" title="Eliminar jugador">
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"></path></svg>
                                      </button>
                                    </form>
                                  </div>
                                </td>
                              </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                      <div class="admin-roster-save">
                        <p class="admin-roster-feedback" role="status" aria-live="polite" data-roster-feedback hidden></p>
                        <button class="admin-roster-save-button" type="button" data-save-roster aria-label="Confirmar y guardar cambios de camiseta y goles">
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 4 4L19 6"></path></svg>
                          Guardar cambios
                        </button>
                      </div>
                    <% } %>
                    </div>
                  </details>
                </article>
              <% }) %>
            <% } %>
          </div>
          <dialog class="admin-modal" id="player-editor-modal" aria-labelledby="player-editor-title">
            <div class="admin-modal__surface">
              <div class="admin-modal__heading">
                <div><p class="eyebrow" id="player-editor-team">PLANTILLA</p><h2 id="player-editor-title">Agregar jugador</h2></div>
                <button class="icon-action" type="button" data-modal-close aria-label="Cerrar formulario">&times;</button>
              </div>
              <form class="dashboard-form admin-modal__form" id="player-editor-form" action="/admin/jugadores" method="post" enctype="multipart/form-data">
                <input type="hidden" name="equipo_id" id="player-editor-team-id">
                <label>Jugador *<input type="text" name="nombre" id="player-editor-name" required></label>
                <label>Grado o sección *<input type="text" name="grado" id="player-editor-grade" required></label>
                <div class="field-row">
                  <label>Número de camiseta *<input type="number" name="numero_camiseta" id="player-editor-number" min="0" max="99" value="0" required></label>
                  <label>Posición<input type="text" name="posicion" id="player-editor-position" placeholder="Defensa, delantero..."></label>
                </div>
                <label>Goles<input type="number" name="goles" id="player-editor-goals" min="0" value="0"></label>
                <div class="player-photo-editor">
                  <label>Foto del jugador (JPG, PNG o WebP; máximo 3 MB)
                    <input type="file" name="foto" id="player-editor-photo" accept="image/jpeg,image/png,image/webp" data-player-photo-input>
                  </label>
                  <div class="player-photo-preview" data-player-photo-preview role="img" aria-label="Vista previa de la foto del jugador">
                    <img src="" alt="" hidden>
                    <span>Vista previa</span>
                  </div>
                  <p class="form-hint">Si no seleccionas otra foto, se conservará la actual.</p>
                </div>
                <div class="admin-modal__actions">
                  <button class="admin-quiet-button" type="button" data-modal-close>Cancelar</button>
                  <button class="btn btn-primary" type="submit" id="player-editor-submit">Agregar jugador</button>
                </div>
              </form>
            </div>
          </dialog>
        </section>

        <section class="panel-card admin-tab-panel" id="posiciones" data-admin-panel="standings" role="tabpanel" aria-labelledby="admin-tab-standings" hidden>
          <p class="eyebrow">CÁLCULO AUTOMÁTICO</p>
          <div class="admin-section-toolbar">
            <h2>Tabla de posiciones</h2>
            <div class="admin-table-tools">
              <input type="search" data-filter-target=".admin-standing-row" placeholder="Buscar equipo..." aria-label="Buscar en posiciones">
              <select data-filter-category aria-label="Filtrar posiciones por categoría"><option value="">Todas las categorías</option><% Array.from(new Set(equipos.map((equipo) => equipo.categoria))).sort().forEach((categoria) => { %><option value="<%= categoria %>"><%= categoria %></option><% }) %></select>
            </div>
          </div>
          <div class="sports-table-wrap">
            <table class="sports-table standings-table">
              <thead><tr><th scope="col">#</th><th scope="col">Equipo</th><th scope="col">PJ</th><th scope="col">PG</th><th scope="col">PE</th><th scope="col">PP</th><th scope="col">GF</th><th scope="col">GC</th><th scope="col">DG</th><th scope="col">Pts</th></tr></thead>
              <tbody>
                <% if (!posiciones.length) { %>
                  <tr><td colspan="10" class="sports-empty">Se calculará cuando se registren equipos y resultados finales.</td></tr>
                <% } else { %>
                  <% posiciones.forEach((equipo) => { %>
                    <tr class="admin-standing-row" data-category="<%= equipo.category %>" data-admin-category="<%= equipo.category %>" data-admin-sport="<%= equipo.deporte || 'futbol' %>"><td class="standings-rank"><%= equipo.rank %></td><th scope="row"><%= equipo.name %><small><%= equipo.category %></small></th><td><%= equipo.played %></td><td><%= equipo.won %></td><td><%= equipo.drawn %></td><td><%= equipo.lost %></td><td><%= equipo.goalsFor %></td><td><%= equipo.goalsAgainst %></td><td><%= equipo.goalDifference %></td><td class="standings-points"><%= equipo.points %></td></tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel-card admin-tab-panel" id="anuncios" data-admin-panel="announcements" data-admin-global="true" role="tabpanel" aria-labelledby="admin-tab-announcements" hidden>
          <div class="admin-section-toolbar">
            <div><p class="eyebrow">COMUNICACIÓN</p><h2>Noticias y avisos</h2></div>
            <button class="btn btn-primary" type="button" data-modal-open="announcement-editor-modal">Editar aviso</button>
          </div>
          <p class="form-hint">Estado actual: <strong><%= popup.activo ? 'Visible' : 'Oculto' %></strong><% if (popup.imagenUrl) { %> · Imagen configurada<% } %></p>
          <dialog class="admin-modal" id="announcement-editor-modal" aria-labelledby="announcement-editor-title">
           <div class="admin-modal__surface">
            <div class="admin-modal__heading"><div><p class="eyebrow">COMUNICACIÓN</p><h2 id="announcement-editor-title">Editar aviso principal</h2></div><button class="icon-action" type="button" data-modal-close aria-label="Cerrar formulario">&times;</button></div>
          <form class="dashboard-form admin-modal__form" action="/admin/popup" method="post" enctype="multipart/form-data" data-announcement-form>
            <label>Título *<input type="text" name="titulo" value="<%= popup.titulo %>" maxlength="140" required data-preview-title></label>
            <label>Mensaje del anuncio *</label>
            <div class="rich-toolbar" role="toolbar" aria-label="Formato del mensaje">
              <button type="button" data-format="bold" aria-label="Negrita"><strong>B</strong></button><button type="button" data-format="italic" aria-label="Cursiva"><em>I</em></button><button type="button" data-format="underline" aria-label="Subrayado"><u>U</u></button><button type="button" data-format="formatBlock" data-format-value="h2" aria-label="Título">H2</button><button type="button" data-format="formatBlock" data-format-value="h3" aria-label="Subtítulo">H3</button><button type="button" data-format="insertUnorderedList" aria-label="Lista">Lista</button><button type="button" data-format="createLink" aria-label="Insertar enlace">Enlace</button><button type="button" data-format="formatBlock" data-format-value="blockquote" aria-label="Cita">Cita</button>
            </div>
            <div class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-required="true" aria-label="Mensaje formateado" data-rich-editor><%- popup.mensaje %></div>
            <textarea name="mensaje" rows="4" hidden data-rich-value><%= popup.mensaje %></textarea>
            <div class="announcement-editor-grid">
              <div>
                <div class="field-row">
                  <label class="admin-dropzone">Imágenes del anuncio (hasta 5)<input type="file" name="imagenAnuncio" accept="image/jpeg,image/png,image/webp" multiple data-image-queue></label>
                  <label>O URL HTTPS de imagen<input type="url" name="imagenUrl" value="<%= (popup.imagenUrl || '').startsWith('https://') ? popup.imagenUrl : '' %>" placeholder="https://..."></label>
                </div>
                <div class="admin-image-thumbnails" data-image-thumbnails aria-live="polite"></div>
              </div>
              <aside class="announcement-live-preview" aria-label="Vista previa en vivo del anuncio">
                <p class="eyebrow">VISTA PREVIA EN VIVO</p>
                <article class="welcome-card">
                  <p class="eyebrow welcome-season">LJV / TEMPORADA 2026</p>
                  <h3 data-preview-title-output><%= popup.titulo %></h3>
                  <div class="announcement-preview-images" data-preview-images>
                    <% (popup.imagenes || []).forEach((image) => { %><img src="<%= image %>" alt="Vista previa de imagen del anuncio"><% }) %>
                  </div>
                  <div class="welcome-message" data-preview-message><%- popup.mensaje %></div>
                </article>
              </aside>
            </div>
            <label class="check-field"><input type="checkbox" name="activo" value="1" <%= popup.activo ? 'checked' : '' %>>Mostrar aviso destacado en la página principal</label>
            <div class="admin-modal__actions"><button class="admin-quiet-button" type="button" data-modal-close>Cancelar</button><button type="submit" class="btn btn-primary">Publicar aviso</button></div>
          </form>
           </div>
          </dialog>
        </section>
        <section class="panel-card admin-tab-panel" id="galeria" data-admin-panel="gallery" data-admin-global="true" role="tabpanel" aria-labelledby="admin-tab-gallery" hidden>
          <div class="admin-section-toolbar">
            <div><p class="eyebrow">FOTOS DEL TORNEO</p><h2>Galería / Carrusel</h2></div>
            <button class="btn btn-primary" type="button" data-modal-open="gallery-upload-modal">+ Subir foto</button>
          </div>
          <dialog class="admin-modal" id="gallery-upload-modal" aria-labelledby="gallery-upload-title">
           <div class="admin-modal__surface">
            <div class="admin-modal__heading"><div><p class="eyebrow">GALERÍA</p><h2 id="gallery-upload-title">Subir foto</h2></div><button class="icon-action" type="button" data-modal-close aria-label="Cerrar formulario">&times;</button></div>
          <form class="dashboard-form gallery-upload-form admin-modal__form" action="/admin/galeria" method="post" enctype="multipart/form-data">
            <div class="field-row">
              <label class="admin-dropzone">Seleccionar fotos (JPG, PNG o WebP; máximo 10) *<input type="file" name="imagen" accept="image/jpeg,image/png,image/webp" multiple required data-image-queue></label>
              <label>Título o descripción (opcional)<input type="text" name="titulo" maxlength="140" placeholder="Ej. Celebración del equipo ganador"></label>
            </div>
            <div class="admin-image-thumbnails" data-image-thumbnails aria-live="polite"></div>
            <div class="admin-modal__actions"><button class="admin-quiet-button" type="button" data-modal-close>Cancelar</button><button type="submit" class="btn btn-primary">+ Añadir foto al carrusel</button></div>
          </form>
           </div>
          </dialog>

          <h3 class="gallery-admin-heading">Fotos del carrusel</h3>
          <% if (!galleryImages.length) { %>
            <p class="gallery-admin-empty">Todavía no hay fotos en la galería.</p>
          <% } else { %>
            <div class="gallery-admin-grid">
              <% galleryImages.forEach((image) => { %>
                <article class="gallery-admin-card">
                  <img src="<%= image.url %>" alt="<%= image.alt %>" loading="lazy">
                  <div class="gallery-admin-card__details">
                    <div><strong><%= image.title || 'Foto de las Interclases' %></strong><small><%= image.filename %> · <%= image.activo ? 'Visible' : 'Oculta' %></small></div>
                    <form action="/admin/galeria/<%= encodeURIComponent(image.id) %>/estado" method="post"><input type="hidden" name="activo" value="<%= image.activo ? '0' : '1' %>"><button class="admin-quiet-button" type="submit"><%= image.activo ? 'Ocultar' : 'Mostrar' %></button></form>
                    <form action="/admin/galeria/<%= encodeURIComponent(image.id) %>/eliminar" method="post" onsubmit="return confirm('¿Eliminar esta foto de la galería?')">
                      <button class="btn btn-danger" type="submit" aria-label="Eliminar <%= image.title || 'foto de las Interclases' %>">Eliminar</button>
                    </form>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>
        <section class="panel-card admin-tab-panel" id="usuarios" data-admin-panel="users" data-admin-global="true" role="tabpanel" aria-labelledby="admin-tab-users" hidden>
          <div class="admin-section-toolbar">
            <div><p class="eyebrow">CUENTAS</p><h2>Gestión de usuarios</h2></div>
          </div>
          <% if (!usuarios.length) { %>
            <p class="sports-empty-block">No hay usuarios registrados.</p>
          <% } else { %>
            <div class="admin-users-table-wrap">
              <table class="admin-users-table">
                <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Fecha de creación</th><th>Acciones</th></tr></thead>
                <tbody>
                  <% usuarios.forEach((usuario) => { %>
                    <tr>
                      <td data-label="Nombre"><strong><%= usuario.nombre %></strong></td>
                      <td data-label="Correo"><%= usuario.email %></td>
                      <td data-label="Rol"><%= usuario.role === 'admin' ? 'Administrador' : 'Estudiante' %></td>
                      <td data-label="Estado"><span class="admin-user-status <%= usuario.activo ? 'is-active' : 'is-inactive' %>"><%= usuario.activo ? 'Activa' : 'Inactiva' %></span></td>
                      <td data-label="Fecha de creación"><%= usuario.creado_en ? new Date(usuario.creado_en).toLocaleDateString('es-CO') : '—' %></td>
                      <td data-label="Acciones"><button class="admin-quiet-button" type="button" data-modal-open="user-password-modal" data-user-id="<%= usuario.id %>" data-user-name="<%= usuario.nombre %>" data-user-email="<%= usuario.email %>">Restablecer contraseña</button></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
          <dialog class="admin-modal" id="user-password-modal" aria-labelledby="user-password-title">
            <div class="admin-modal__surface">
              <div class="admin-modal__heading">
                <div><p class="eyebrow">GESTIÓN DE CUENTAS</p><h2 id="user-password-title">Restablecer contraseña</h2></div>
                <button class="icon-action" type="button" data-modal-close aria-label="Cerrar formulario">&times;</button>
              </div>
              <p class="form-hint" data-user-password-target></p>
              <form class="dashboard-form admin-modal__form" id="user-password-form" action="#" method="post" data-user-password-form>
                <label>Nueva contraseña
                  <input type="password" name="password" id="user-password-input" minlength="8" pattern="(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}" autocomplete="new-password" required>
                </label>
                <small class="form-hint">Mínimo 8 caracteres, una mayúscula, un número y un carácter especial.</small>
                <label>Confirmar nueva contraseña
                  <input type="password" name="confirmPassword" id="user-password-confirm" minlength="8" autocomplete="new-password" required>
                </label>
                <p class="admin-form-feedback" data-user-password-feedback role="status" aria-live="polite"></p>
                <div class="admin-modal__actions">
                  <button class="admin-quiet-button" type="button" data-modal-close>Cancelar</button>
                  <button type="submit" class="btn btn-primary">Guardar contraseña</button>
                </div>
              </form>
            </div>
          </dialog>
        </section>
      </section>
    </main>
    <%- include('../partials/accessibility-settings') %>
    <script src="/js/admin-dashboard.js?v=team-management-20261017" defer></script>
  </body>
</html>
