<!doctype html>
<html lang="es">
  <%- include('partials/head', { title }) %>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card">
        <div class="auth-brand">
          <h1>Iniciar sesión</h1>
          <p>Ingresa con tu cuenta para consultar equipos, partidos y resultados.</p>
        </div>

        <% if (error) { %>
          <div class="auth-alert error"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert success"><%= success %></div>
        <% } %>

        <form class="auth-form" action="/login" method="post">
          <label>
            <span>Correo electrónico</span>
            <input type="email" name="email" placeholder="correo@ejemplo.com" value="<%= formData.email || '' %>" required>
          </label>

          <label>
            <span>Contraseña</span>
            <span class="password-field">
              <input type="password" name="password" placeholder="Ejemplo: FutbolLJV2026!" required>
              <button class="password-toggle" type="button" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false">
                <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z"></path>
                  <circle cx="12" cy="12" r="2.5"></circle>
                  <line class="eye-slash" x1="4" y1="4" x2="20" y2="20"></line>
                </svg>
              </button>
            </span>
          </label>

          <button type="submit">Entrar</button>
        </form>

        <p class="auth-footer">
          <a href="/forgot-password">¿Olvidaste tu contraseña?</a>
        </p>

        <p class="auth-footer">
          ¿Aún no tienes cuenta?
          <a href="/registro">Regístrate</a>
        </p>

        <a class="text-link" href="/">Volver al inicio</a>
      </section>
    </main>
    <%- include('partials/accessibility-settings') %>
    <script src="/js/password-toggle.js" defer></script>
  </body>
</html>
