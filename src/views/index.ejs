<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="modal-open">
  <%- include('partials/navbar', { user }) %>

  <main class="container">
    <section class="match-carousel" id="match-carousel" aria-labelledby="match-carousel-title">
      <% if (error) { %>
        <div class="auth-alert error"><%= error %></div>
      <% } %>
      <div class="match-carousel__heading">
        <div>
          <p class="eyebrow section-eyebrow">Jornada en juego</p>
          <h2 id="match-carousel-title">Proximos partidos</h2>
        </div>
        <div class="match-carousel__controls" aria-label="Navegacion de partidos">
          <button class="match-carousel__arrow" type="button" data-carousel-prev aria-label="Partido anterior">&#8592;</button>
          <button class="match-carousel__arrow" type="button" data-carousel-next aria-label="Partido siguiente">&#8594;</button>
        </div>
      </div>

      <div class="match-carousel__viewport" data-carousel-viewport tabindex="0">
        <div class="match-carousel__track" data-carousel-track>
          <% if (matches.length === 0) { %>
            <article class="match-card match-card--empty" data-carousel-slide>
              <strong>No hay partidos programados</strong>
              <span>Los proximos encuentros apareceran aqui cuando sean registrados.</span>
            </article>
          <% } else { %>
            <% matches.forEach((match) => { %>
              <article class="match-card" data-carousel-slide>
                <div class="match-card__topline">
                  <time datetime="<%= match.date %>T<%= match.time %>"><%= match.date %> · <%= match.time %></time>
                  <span class="match-card__status"><%= match.status %></span>
                </div>
                <div class="match-card__teams">
                  <strong><%= match.homeTeam || 'Equipo local' %></strong>
                  <span>vs.</span>
                  <strong><%= match.awayTeam || 'Equipo visitante' %></strong>
                </div>
                <div class="match-card__details">
                  <span><span aria-hidden="true">&#9679;</span> <%= match.field || 'Cancha por confirmar' %></span>
                  <% if (match.result) { %>
                    <span><%= match.result %></span>
                  <% } %>
                </div>
              </article>
            <% }) %>
          <% } %>
        </div>
      </div>

      <div class="match-carousel__dots" data-carousel-dots aria-label="Seleccionar partido"></div>
    </section>

    <section class="gallery-hero" aria-label="Galería de las Interclases LJV">
      <% if (galleryImages.length) { %>
        <div class="gallery-carousel" data-gallery-carousel aria-roledescription="carrusel">
          <div class="gallery-carousel__viewport" data-gallery-viewport>
            <% galleryImages.forEach((image, index) => { %>
              <figure class="gallery-slide <%= index === 0 ? 'is-active' : '' %>" data-gallery-slide aria-hidden="<%= index === 0 ? 'false' : 'true' %>" role="group" aria-roledescription="diapositiva" aria-label="Imagen <%= index + 1 %> de <%= galleryImages.length %>">
                <img src="<%= image.url %>" alt="<%= image.alt %>" <%= index === 0 ? 'fetchpriority=high' : 'loading=lazy' %>>
                <figcaption class="gallery-slide__overlay">
                  <span class="gallery-slide__eyebrow">Interclases LJV · Temporada 2026</span>
                  <% if (image.title) { %><h2><%= image.title %></h2><% } %>
                </figcaption>
              </figure>
            <% }) %>
          </div>
          <% if (galleryImages.length > 1) { %>
            <button class="gallery-carousel__arrow gallery-carousel__arrow--previous" type="button" data-gallery-previous aria-label="Foto anterior">&#8592;</button>
            <button class="gallery-carousel__arrow gallery-carousel__arrow--next" type="button" data-gallery-next aria-label="Foto siguiente">&#8594;</button>
            <div class="gallery-carousel__indicators" role="group" aria-label="Seleccionar foto">
              <% galleryImages.forEach((image, index) => { %>
                <button class="gallery-carousel__indicator <%= index === 0 ? 'is-active' : '' %>" type="button" data-gallery-indicator="<%= index %>" aria-label="Mostrar foto <%= index + 1 %>" aria-current="<%= index === 0 ? 'true' : 'false' %>"></button>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="gallery-empty">
          <p class="eyebrow section-eyebrow">Interclases LJV · Temporada 2026</p>
          <h2>La galería se está preparando</h2>
        </div>
      <% } %>
    </section>

  </main>

  <footer class="institution-footer">
    <div class="institution-card">
      <div class="institution-heading">
        <div>
          <p class="institution-kicker">Información institucional</p>
          <h2>Institución Educativa Lucrecio Jaramillo Vélez</h2>
        </div>
        <img
          class="institution-crest"
          src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQjyPasuwCjM-T9wsh9KY8AYvZD7m4WFiufQGn7CtHjNLxS7BpOdR9xHB2v&s=10"
          alt="Escudo de la Institución Educativa Lucrecio Jaramillo Vélez"
        >
      </div>

      <div class="institution-details">
        <section class="institution-location" aria-labelledby="main-campus-title">
          <h3 id="main-campus-title">Sede Principal</h3>
          <address>
            <p><strong>Dirección</strong><br>Carrera 79 No. 38 - 59 Barrio Laureles, Medellín</p>
            <p><strong>Horario de Atención</strong><br>Lunes a Viernes 8:00 am - 12:00 pm</p>
            <p><strong>Teléfono</strong><br><a href="tel:+57604">+57 (604)</a></p>
            <p><strong>Correo Electrónico</strong><br><a href="mailto:soporte.interclases.ljv@gmail.com">soporte.interclases.ljv@gmail.com</a></p>
          </address>

          <div class="institution-socials">
            <h3>Redes Sociales</h3>
            <div class="social-links">
              <a href="https://www.instagram.com/lucrecio.jaramillo" target="_blank" rel="noreferrer" aria-label="Instagram lucrecio.jaramillo">
                <span class="social-icon social-icon--instagram" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <rect x="4" y="4" width="16" height="16" rx="4"></rect>
                    <circle cx="12" cy="12" r="3.5"></circle>
                    <circle class="social-icon__dot" cx="17.2" cy="6.8" r="1"></circle>
                  </svg>
                </span>
                <span>@lucrecio.jaramillo</span>
              </a>
              <a href="https://www.tiktok.com/@lucrecio.jaramillo?_r=1&amp;_t=ZS-945swAdCOxO&amp;fbclid=PAcGRvZgJleHRuA2FlbQIxMQBzcnRjBmFwcF9pZA85MzY2MTk3NDMzOTI0NTkAAacbWs9aLrCySE82jBBCyA7TL0SErdZE6yi3Qd1G-70RXFiLVPcli809DtGdWA_aem_oqipKY7U8_mnXosoXO1a6Q" target="_blank" rel="noreferrer" aria-label="TikTok lucrecio.jaramillo">
                <span class="social-icon social-icon--tiktok" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M14 4v10.2a4.3 4.3 0 1 1-3.1-4.1"></path>
                    <path d="M14 4c.6 2.3 2.1 3.7 4.5 4.2"></path>
                  </svg>
                </span>
                <span>@lucrecio.jaramillo</span>
              </a>
              <a href="https://www.youtube.com/@direccionlucreciojaramillo2193" target="_blank" rel="noreferrer" aria-label="YouTube @direccionlucreciojaramillo2193">
                <span class="social-icon social-icon--youtube" aria-hidden="true">&#9654;</span>
                <span>@direccionlucreciojaramillo2193</span>
              </a>
            </div>
          </div>
        </section>

        <section class="institution-location" aria-labelledby="primary-campus-title">
          <h3 id="primary-campus-title">Sede Preescolar y Primaria</h3>
          <address>
            <p><strong>Dirección</strong><br>Calle 44A No. 75 - 68 Barrio Florida Nueva, Medellín</p>
          </address>
        </section>
      </div>

      <nav class="institution-links" aria-label="Enlaces institucionales">
        <a href="#politica-datos">Política de tratamiento de datos</a>
        <a href="#mapa-sitio">Mapa del sitio</a>
        <a class="teacher-access" href="/login">Acceso Docente</a>
      </nav>
    </div>
  </footer>

  <% if (popup && popup.activo) { %>
    <div class="welcome-modal" id="welcome-modal" role="dialog" aria-modal="true" aria-labelledby="welcome-title">
      <div class="welcome-card">
        <button class="welcome-close" type="button" aria-label="Cerrar mensaje de bienvenida">&times;</button>
        <p class="eyebrow welcome-season">LJV / TEMPORADA 2026</p>
        <h2 id="welcome-title"><%= popup.titulo %></h2>
        <p><%= popup.mensaje %></p>
        <button class="btn btn-primary welcome-button" type="button">Continuar</button>
      </div>
    </div>
  <% } %>

  <script>
    const welcomeModal = document.getElementById('welcome-modal');
    if (welcomeModal) {
      const closeWelcomeButtons = welcomeModal.querySelectorAll('.welcome-close, .welcome-button');

      function closeWelcomeModal() {
        welcomeModal.classList.add('is-hidden');
        document.body.classList.remove('modal-open');
      }

      closeWelcomeButtons.forEach((button) => button.addEventListener('click', closeWelcomeModal));
      welcomeModal.addEventListener('click', (event) => {
        if (event.target === welcomeModal) closeWelcomeModal();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeWelcomeModal();
      });
    } else {
      document.body.classList.remove('modal-open');
    }
  </script>
  <script src="/js/match-carousel.js" defer></script>
  <script src="/js/gallery-carousel.js" defer></script>
  <script src="/js/navigation.js" defer></script>
  <%- include('partials/accessibility-settings') %>
</body>
</html>
